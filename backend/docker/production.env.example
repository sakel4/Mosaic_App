# Copy this file to production.env and replace every placeholder before deployment.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=your-ec2-public-dns-or-api-domain

# Include the frontend's exact origin(s), including scheme and port when nonstandard.
CORS_ALLOWED_ORIGINS=https://your-frontend-domain
CSRF_TRUSTED_ORIGINS=https://your-frontend-domain

# Use the RDS PostgreSQL endpoint, database, and credentials.
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=5432
DB_NAME=app
DB_USER=your-database-user
DB_PASSWORD=replace-with-your-database-password
DB_SSLMODE=require
DB_CONN_MAX_AGE=60

# Amazon Transcribe Streaming assessment. Audio must be mono, 16 kHz, 16-bit PCM WAV.
AWS_DEFAULT_REGION=eu-west-1
TRANSCRIBE_LANGUAGE=en-GB
TRANSCRIBE_MIN_WORD_CONFIDENCE=0.35
MAX_SPOKEN_AUDIO_BYTES=10485760
MAX_SPOKEN_AUDIO_SECONDS=60
TRANSCRIBE_STREAM_TIMEOUT_SECONDS=80

# Public HTTP port exposed by Nginx; allow this port in the EC2 security group.
HTTP_PORT=80

# Progress report emails. Use your provider's SMTP credentials and verified sender.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=in-v3.mailjet.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-your-mailjet-api-key
EMAIL_HOST_PASSWORD=replace-with-your-mailjet-secret-key
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL="Mosaic <reports@your-domain.com>"
